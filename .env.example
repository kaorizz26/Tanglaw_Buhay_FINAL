# Copy to local .env and replace placeholders. .env is Git-ignored; never commit credentials.
# The app connects only when db.get_connection() is explicitly used.
DATABASE_URL=postgresql://username:password@localhost:5432/tanglaw_buhay_dev
# Synthetic schema tests require this separate, local test database.
TANGLAW_TEST_DATABASE_URL=postgresql://username:password@localhost:5432/tanglaw_buhay_test
# Generate a unique random key locally; no built-in signing key is supplied.
SECRET_KEY=
# Separate Fernet key for revealing pending staff temporary passwords; see README.
STAFF_TEMP_PASSWORD_KEY=
# Separate random secret (at least 32 characters) for citizen activation and reset credentials.
CITIZEN_CREDENTIAL_KEY=
# HTTPS is required by default. Set false only for loopback HTTP development.
SESSION_COOKIE_SECURE=true
# Citizen and staff-account emails. Use a dedicated Tanglaw-Buhay sender account.
# For Gmail use smtp.gmail.com, port 587, starttls and a Google App Password.
# Links in emails are built from PUBLIC_BASE_URL, never from the request.
PUBLIC_BASE_URL=http://127.0.0.1:5000
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) or ssl (port 465)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Who may receive email. 'allowlist' (default) sends only to SMTP_ALLOWED_RECIPIENTS and
# stays closed if the list is empty. 'any' lets the system email any valid recipient; it
# needs an empty SMTP_ALLOWED_RECIPIENTS. Use 'any' only when sending is approved.
SMTP_RECIPIENT_MODE=allowlist
# Comma-separated addresses that may receive email in 'allowlist' mode.
SMTP_ALLOWED_RECIPIENTS=
# Digital Dropbox: absolute path of a private folder for uploaded documents. It must be
# outside the project folder, must already exist, and is backed up with the database.
DOCUMENT_STORAGE_DIR=
# Data Import (optional): absolute path of a private folder for temporary uploaded CSV files.
# Leave empty to use the system temporary folder. The folder is created if missing, must not
# be inside the project folder, holds at most 1 GiB, and abandoned files are removed after 24 hours.
IMPORT_STAGING_DIR=
# Data Import references: absolute path to the system-installed folder containing
# the three approved reference CSVs. Required for an empty database's first import.
# The folder contains no household/member records and should be deployment-controlled.
IMPORT_REFERENCE_DIR=
