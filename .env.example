# Copy to local .env and replace placeholders. .env is Git-ignored; never commit credentials.
# The app connects only when db.get_connection() is explicitly used.
DATABASE_URL=postgresql://username:password@localhost:5432/tanglaw_buhay_dev
# Synthetic schema tests require this separate, local test database.
TANGLAW_TEST_DATABASE_URL=postgresql://username:password@localhost:5432/tanglaw_buhay_test
# Generate a unique random key locally; no built-in signing key is supplied.
SECRET_KEY=
# Separate Fernet key for revealing pending staff temporary passwords; see README.
STAFF_TEMP_PASSWORD_KEY=
# HTTPS is required by default. Set false only for loopback HTTP development.
SESSION_COOKIE_SECURE=true
